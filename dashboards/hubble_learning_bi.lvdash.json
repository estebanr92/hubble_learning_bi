{
  "datasets": [
    {
      "name": "ds_cohort",
      "displayName": "Scores by cohort (all months)",
      "queryLines": [
        "SELECT year_month, category, avg_score, child_count \n",
        "FROM agg_scores_by_cohort"
      ]
    },
    {
      "name": "ds_cohort_trend",
      "displayName": "Scores by cohort (chronological trend)",
      "queryLines": [
        "SELECT year_month, category, avg_score, child_count \n",
        "FROM agg_scores_by_cohort \n",
        "WHERE year_month != 'other' \n",
        "ORDER BY year_month"
      ]
    },
    {
      "name": "ds_segment",
      "displayName": "Scores by demographic segment",
      "queryLines": [
        "SELECT region, locale, relationship_to_child, child_gender, age_band, category, avg_score, child_count \n",
        "FROM agg_scores_by_segment"
      ]
    },
    {
      "name": "ds_scatter",
      "displayName": "Parent confidence vs. other categories (by segment)",
      "queryLines": [
        "SELECT \n",
        "  a.region, a.locale, a.relationship_to_child, a.child_gender, a.age_band, \n",
        "  a.avg_score AS parent_confidence_score, \n",
        "  b.category AS other_category, \n",
        "  b.avg_score AS other_category_score, \n",
        "  b.child_count \n",
        "FROM agg_scores_by_segment a \n",
        "JOIN agg_scores_by_segment b \n",
        "  ON a.region = b.region AND a.locale = b.locale \n",
        "  AND a.relationship_to_child = b.relationship_to_child \n",
        "  AND a.child_gender = b.child_gender AND a.age_band = b.age_band \n",
        "WHERE a.category = 'parent_confidence' AND b.category != 'parent_confidence'"
      ]
    },
    {
      "name": "ds_funnel",
      "displayName": "Funnel completion (by cohort)",
      "queryLines": [
        "SELECT year_month, registered_children, completed_survey_children, chose_priorities_children, \n",
        "       pct_completed_survey, pct_chose_priorities \n",
        "FROM funnel_completion"
      ],
      "columns": [
        {
          "displayName": "Total Registered",
          "description": "Total children registered across all cohorts",
          "expression": "SUM(`registered_children`)"
        },
        {
          "displayName": "Completion Rate",
          "description": "Share of registered children who answered at least 25 of 30 questions",
          "expression": "SUM(`completed_survey_children`) * 1.0 / SUM(`registered_children`)"
        },
        {
          "displayName": "Priority Rate",
          "description": "Share of registered children who went on to pick skill priorities",
          "expression": "SUM(`chose_priorities_children`) * 1.0 / SUM(`registered_children`)"
        }
      ]
    },
    {
      "name": "ds_funnel_stages",
      "displayName": "Funnel stages (reshaped for funnel chart)",
      "queryLines": [
        "SELECT 1 AS stage_order, 'Registered' AS stage, SUM(registered_children) AS count FROM funnel_completion \n",
        "UNION ALL \n",
        "SELECT 2, 'Completed survey', SUM(completed_survey_children) FROM funnel_completion \n",
        "UNION ALL \n",
        "SELECT 3, 'Chose priorities', SUM(chose_priorities_children) FROM funnel_completion \n",
        "ORDER BY stage_order"
      ]
    },
    {
      "name": "ds_gap",
      "displayName": "Gap analysis (all months)",
      "queryLines": [
        "SELECT year_month, eligible_children, matching_children, pct_priority_matches_weakest \n",
        "FROM gap_analysis_summary"
      ],
      "columns": [
        {
          "displayName": "Overall Match Rate",
          "description": "Share of eligible children whose weakest category matched their #1 priority skill",
          "expression": "SUM(`matching_children`) * 1.0 / SUM(`eligible_children`)"
        }
      ]
    },
    {
      "name": "ds_gap_trend",
      "displayName": "Gap analysis (chronological trend)",
      "queryLines": [
        "SELECT year_month, eligible_children, matching_children, pct_priority_matches_weakest \n",
        "FROM gap_analysis_summary \n",
        "WHERE year_month != 'other' \n",
        "ORDER BY year_month"
      ]
    },
    {
      "name": "ds_dq",
      "displayName": "Pipeline observability",
      "queryLines": [
        "SELECT dt, rows_ingested, ingestion_lag_days, dirty_answer_value_rows, duplicate_rows, \n",
        "       unknown_question_rows, pct_dirty_answer_value, pct_duplicate, pct_unknown_question \n",
        "FROM dq_pipeline_observability \n",
        "ORDER BY dt"
      ],
      "columns": [
        {
          "displayName": "Duplicate Rate",
          "description": "Share of ingested survey-response rows that were exact duplicates",
          "expression": "SUM(`duplicate_rows`) * 1.0 / SUM(`rows_ingested`)"
        },
        {
          "displayName": "Dirty Answer Rate",
          "description": "Share of ingested rows with a non-canonical answer_value (typos/casing)",
          "expression": "SUM(`dirty_answer_value_rows`) * 1.0 / SUM(`rows_ingested`)"
        },
        {
          "displayName": "Unknown Question Rate",
          "description": "Share of ingested rows referencing a question_id not in the catalog",
          "expression": "SUM(`unknown_question_rows`) * 1.0 / SUM(`rows_ingested`)"
        }
      ]
    }
  ],
